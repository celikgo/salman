PROGRAM P
VAR I : DINT; N : DINT; B : BOOL; END_VAR
IF B THEN N := 1; ELSIF N > 0 THEN N := 2; ELSE N := 3; END_IF;
CASE N OF 0: B := FALSE; 1, 2: B := TRUE; 3..9: B := NOT B; ELSE N := 0; END_CASE;
FOR I := 1 TO 10 BY 2 DO N := N + I; EXIT; END_FOR;
WHILE N > 0 DO N := N - 1; END_WHILE;
REPEAT N := N + 1; UNTIL N >= 5 END_REPEAT;
END_PROGRAM
